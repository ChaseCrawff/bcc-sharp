def radius : ℕ := 6

def pick (l : List FJet) (k j : Fin 3) : FJet := l.getD (3*k.val+j.val) fzeroJet

def zeroH : Fin 5 → Fin 5 → FBall := fun _ _ => FixedPoint.Ball.zero

def pickSlab (l : List (Fin 5 → Fin 5 → FBall)) (a : ℤ) : Fin 5 → Fin 5 → FBall :=
  l.getD (a + 6).toNat zeroH

def tailWitness (R : ℕ) (a : ℚ) : LocalTailWitness :=
  ⟨0, fun _ => expShort (Ball.exact 0), ⟨expShort (ratioArgument a R), expShort (edgeArgument a R)⟩⟩

def analyticData : LocalData :=
  let index : Bool → Fin 3 → Fin 3 → FJet := fun d => if d then pick analytic_dual else pick analytic_direct
  let rat (d : Bool) : Fin 3 → Fin 3 → StrainJet Ball := fun k l => ratJet (index d k l)
  let a (d : Bool) : ℚ := if d then 1 else 23/32
  { chart := shortChart .bcc analyticLocalBox, length := lengthRoot, radius := radius, index := index,
    exponent := a,
    exponentFactor := fun d => rationalLdlProposal (shiftedIndexMetric (rat d) (a d)),
    tail := fun d _ _ => tailWitness radius (a d) }

theorem analyticData_radius : analyticData.radius = 6 := rfl

def qbox (u0 u1 : Bool) : Rectangle := split (split ballRoot 0 (beta/2) u0) 1 (beta/2) u1

def cscale (dual : Bool) : FBall := FixedPoint.Ball.fromBall (qscaleBall .bcc dual lengthRoot)

end BccSharp.Coulomb.BravaisCover.FixedLocal.BccBall
