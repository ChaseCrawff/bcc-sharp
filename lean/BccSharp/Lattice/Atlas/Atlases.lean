theorem strainAtlases_closed : ∀ ref, AtlasClosed ref (strainRoot ref)
  | .bcc => bccClosed
  | .fcc => fccClosed

theorem strainAtlases_sharp (ref : Reference) (w : Point) (live : strainEligible ref w) :
    strainSharp ref w :=
  sharp_of_closed ref (strainAtlases_closed ref) w live

theorem latticeCase_from_tangent_forest_atlases {count : ℕ} (positive : 0 < count) (g : Grid count)
    (gOK : g.check globalRoot = true) (T : Tables) (hT : T.Valid)
    (forest : (Fin 2 → Fin count) → (Fin 3 → Fin count) → AddressedTree TPayload)
    (checked : ∀ owner suffix, (forest owner suffix).check (tangentGlobalCheck T)
      (gridAddress .global (Fin.append owner suffix)) (g.box (Fin.append owner suffix)) = true) :
    LatticeCase :=
  latticeCase_from_tangent_forest_closed positive g gOK T hT forest checked strainAtlases_closed

