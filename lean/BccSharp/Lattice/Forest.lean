def forest (owner : Fin 2 → Fin 4) (suffix : Fin 3 → Fin 4) : AddressedTree TPayload :=
  (plans (owner 0) (owner 1) (suffix 0) (suffix 1) (suffix 2)).build (rootAddress owner suffix)
    (rootBox owner suffix)

theorem forest_checked (owner : Fin 2 → Fin 4) (suffix : Fin 3 → Fin 4) :
    (forest owner suffix).check (tangentGlobalCheck Tables.tables)
      (gridAddress .global (Fin.append owner suffix)) (grid.box (Fin.append owner suffix)) = true := by
  have h := plans_checked (owner 0) (owner 1) (suffix 0) (suffix 1) (suffix 2)
  have ho : ![owner 0, owner 1] = owner := by
    funext i
    fin_cases i <;> rfl
  have hs : ![suffix 0, suffix 1, suffix 2] = suffix := by
    funext i
    fin_cases i <;> rfl
  rw [ho, hs] at h
  exact h

theorem latticeCase_of_atlases (atlas : Reference → AtlasRows)
    (atlasOK : ∀ ref, (atlas ref).check ref = true) : LatticeCase :=
  latticeCase_from_tangent_forest (by decide) grid grid_check Tables.tables Tables.tables_valid
    forest forest_checked atlas atlasOK

end BccSharp.Coulomb.BravaisCover.TangentCover.Forest
