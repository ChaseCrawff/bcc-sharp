def analyticData : LocalData :=
  let index : Bool → Fin 3 → Fin 3 → FJet := fun d => if d then pick analytic_dual else pick analytic_direct
  let rat (d : Bool) : Fin 3 → Fin 3 → StrainJet Ball := fun k l => ratJet (index d k l)
  let a (d : Bool) : ℚ := if d then 1 else 3/2
  { chart := shortChart .fcc analyticLocalBox, length := lengthRoot, radius := radius, index := index,
    exponent := a,
    exponentFactor := fun d => rationalLdlProposal (shiftedIndexMetric (rat d) (a d)),
    tail := fun d _ _ => tailWitness radius (a d) }

theorem analyticData_radius : analyticData.radius = 5 := rfl

def qbox (u0 u1 : Bool) : Rectangle := split (split ballRoot 0 (beta/2) u0) 1 (beta/2) u1

def cscale (dual : Bool) : FBall := FixedPoint.Ball.fromBall (qscaleBall .fcc dual lengthRoot)

end BccSharp.Coulomb.BravaisCover.FixedLocal.FccBall
