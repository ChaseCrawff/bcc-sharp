theorem leaf_3_good : ∀ p, leaf_3.Mem p → good p → Route.result .strictFCC p :=
  fun p hp gp => leaf_3_sound p hp gp.1
theorem leaf_3_all : ∀ p, leaf_3.Mem p → energy fcc < energy (chartPoint p) :=
  fun p hp => leaf_3_sound p hp (valid_of_box leaf_3 (0) (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel) p hp)

end BccSharp.Coulomb.CompactCover.LeafFix.FLeaves
