import BccSharp.TwoSite.ReferencePacket

set_option autoImplicit false

/-! Per-shell kernel certificate for the Constants BCC and FCC reference energies.

Generated from the shell data of `BccSharp.TwoSite.ReferencePacket`. Every literal below is
re-derived by the kernel: `*_keys` recomputes the integer shell histogram, and
each per-shell theorem recomputes the erfc or exponential check and the rounded
ball for that shell. The literals only split the kernel work into small
declarations so that each check keeps a small cache. -/

noncomputable section
open scoped BigOperators

namespace BccSharp.Coulomb.Constants
open BccSharp
open BccSharp.Intervals (Ball)
open HighPrecision

structure ShellCert where
  key : ℤ
  mult : ℕ
  ball : Ball

def ShellCert.pair (c : ShellCert) : ℤ × ℕ := (c.key, c.mult)

def certTerm (c : ShellCert) : Ball := (Ball.exact (c.mult : ℚ)).mul c.ball

def certSum (L : List ShellCert) : Ball :=
  ⟨(L.map (fun c => (certTerm c).mid)).sum, (L.map (fun c => (certTerm c).rad)).sum⟩

theorem certSum_sound (L : List ShellCert) (val : ℤ → ℝ)
    (h : ∀ c ∈ L, c.ball.Contains (val c.key)) :
    (certSum L).Contains ((L.map (fun c => (c.mult : ℝ) * val c.key)).sum) := by
  induction L with
  | nil =>
      simp only [certSum, List.map_nil, List.sum_nil]
      exact_mod_cast Ball.contains_exact 0
  | cons c rest ih =>
      have h₁ : (certTerm c).Contains ((c.mult : ℝ) * val c.key) := by
        simpa only [certTerm, Rat.cast_natCast] using
          Ball.contains_mul (Ball.contains_exact (c.mult : ℚ)) (h c (by simp))
      have h₂ := ih (fun c' hc' => h c' (List.mem_cons_of_mem c hc'))
      simpa [certSum, Ball.add] using Ball.contains_add h₁ h₂

theorem direct_sum_cert (ref : Reference) (L : List ShellCert)
    (hL : L.map ShellCert.pair = directShells ref) :
    ∑ z ∈ ref.directPoints, ref.directValue (ref.realRadius z) =
      (L.map (fun c => (c.mult : ℝ) * ref.directValue ((c.key : ℚ) / 4))).sum := by
  rw [sum_directPoints]
  simp only [realRadius_key]
  rw [← histogram_sum (fun k => ref.directValue ((k : ℚ) / 4)) (directKey ref) (directList ref)]
  change ((directShells ref).map _).sum = _
  rw [← hL, List.map_map]
  rfl

theorem reciprocal_sum_cert (ref : Reference) (L : List ShellCert)
    (hL : L.map ShellCert.pair = reciprocalShells ref) :
    ∑ z ∈ ref.reciprocalPoints, ref.reciprocalValue (ref.dualRadius z) =
      (L.map (fun c => (c.mult : ℝ) * ref.reciprocalValue (c.key : ℚ))).sum := by
  rw [sum_reciprocalPoints]
  simp only [dualRadius_key]
  rw [← histogram_sum (fun k => ref.reciprocalValue (k : ℚ)) (dualKey ref) (dualList ref)]
  change ((reciprocalShells ref).map _).sum = _
  rw [← hL, List.map_map]
  rfl

def certFiniteBall (ref : Reference) (Ld Lr : List ShellCert) : Ball :=
  let s := (certSum Ld).add (certSum Lr)
  let u := (s.add (selfBall ref)).add (backgroundBall ref)
  round ((cubeRoot ref).ball.mul u)

theorem certFiniteBall_sound (ref : Reference) (Ld Lr : List ShellCert)
    (pc : piRoot.check piInput = true) (cc : cubeCheck ref = true)
    (hd : Ld.map ShellCert.pair = directShells ref)
    (hr : Lr.map ShellCert.pair = reciprocalShells ref)
    (hdc : ∀ c ∈ Ld, c.ball.Contains (ref.directValue ((c.key : ℚ) / 4)))
    (hrc : ∀ c ∈ Lr, c.ball.Contains (ref.reciprocalValue (c.key : ℚ))) :
    (certFiniteBall ref Ld Lr).Contains ref.finiteEnergy := by
  have hD := certSum_sound Ld (fun k => ref.directValue ((k : ℚ) / 4)) hdc
  have hR := certSum_sound Lr (fun k => ref.reciprocalValue (k : ℚ)) hrc
  rw [← direct_sum_cert ref Ld hd] at hD
  rw [← reciprocal_sum_cert ref Lr hr] at hR
  have hself := Ball.contains_mul (Ball.contains_exact (-ref.alpha)) (piInverseRoot_sound pc)
  have hbg := Ball.contains_mul (Ball.contains_exact (-1/(2*ref.naturalVolume*ref.alpha^2))) piInput_sound
  have hsum := Ball.contains_add (Ball.contains_add (Ball.contains_add hD hR) hself) hbg
  have raw := round_sound (Ball.contains_mul (cubeRoot_sound ref cc) hsum)
  convert raw using 1
  · rfl
  · unfold Reference.finiteEnergy Reference.realRadius Reference.dualRadius
    push_cast
    ring

def certFinalBounds (ref : Reference) (Ld Lr : List ShellCert) : Interval :=
  let b := certFiniteBall ref Ld Lr
  (⟨b.mid - b.rad, b.mid + b.rad⟩ : Interval).add ⟨0, exactTailUpper⟩

theorem cert_primitive_bounds (ref : Reference) (Ld Lr : List ShellCert)
    (pc : piRoot.check piInput = true) (cc : cubeCheck ref = true)
    (hd : Ld.map ShellCert.pair = directShells ref)
    (hr : Lr.map ShellCert.pair = reciprocalShells ref)
    (hdc : ∀ c ∈ Ld, c.ball.Contains (ref.directValue ((c.key : ℚ) / 4)))
    (hrc : ∀ c ∈ Lr, c.ball.Contains (ref.reciprocalValue (c.key : ℚ)))
    (hi : (certFinalBounds ref Ld Lr).inside ref.bracket = true) :
    ref.bracket.contains ref.primitiveWS := by
  have finite := (SpecialFunctions.contains_iff_endpoints _ _).mp
    (certFiniteBall_sound ref Ld Lr pc cc hd hr hdc hrc)
  have hf : (⟨(certFiniteBall ref Ld Lr).mid - (certFiniteBall ref Ld Lr).rad,
      (certFiniteBall ref Ld Lr).mid + (certFiniteBall ref Ld Lr).rad⟩ : Interval).contains
        ref.finiteEnergy := by
    simpa [Interval.contains, Rat.cast_add, Rat.cast_sub] using finite
  have hb := Interval.add_sound hf (finite_and_tail ref)
  rw [show ref.finiteEnergy + (ref.primitiveWS - ref.finiteEnergy) = ref.primitiveWS by ring] at hb
  exact Interval.inside_sound hi hb

